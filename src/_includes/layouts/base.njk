<!doctype html>
<html lang="fr" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set titreComplet = titreOnglet or (title + " · " + site.nom) %}
  <title>{{ titreComplet }}</title>
  <meta name="description" content="{{ description }}">
  {%- if robots %}
  <meta name="robots" content="{{ robots }}">
  {%- endif %}
  <link rel="canonical" href="{{ page.url | urlAbsolue }}">

  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content="{{ site.nom }}">
  <meta property="og:title" content="{{ titreComplet }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ page.url | urlAbsolue }}">
  <meta property="og:image" content="{{ site.imagePartage | urlAbsolue }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ site.imagePartageAlt }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#141213">

  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/assets/img/favicon-32.png" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <link rel="preload" href="/assets/fonts/anton-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/barlow-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/main.css?v={{ generation.date.getTime() }}">
  <script>document.documentElement.classList.replace("no-js", "js");</script>
  <script src="/assets/js/main.js?v={{ generation.date.getTime() }}" defer></script>
  {%- if scriptPage %}
  <script src="/assets/js/{{ scriptPage }}?v={{ generation.date.getTime() }}" defer></script>
  {%- endif %}
  {%- if page.url == "/" %}
  {#- Le club et le triathlon pour les moteurs de recherche (src/_data/donneesStructurees.js) #}
  <script type="application/ld+json">{{ donneesStructurees | dump | safe }}</script>
  {%- endif %}
</head>
<body>
  <a class="lien-evitement" href="#contenu">Aller au contenu</a>
  {% include "composants/en-tete.njk" %}
  <main id="contenu" tabindex="-1">
    {{ content | safe }}
  </main>
  {% include "composants/pied-de-page.njk" %}
  {%- if contenusMeta %}
  {% include "composants/bandeau-meta.njk" %}
  {%- endif %}
  <span id="nouvel-onglet" hidden>(s'ouvre dans un nouvel onglet)</span>
</body>
</html>
